<simulation>
  <!-- ======== Simulation control settings ======== -->
  <control>
    <duration>720</duration> <!-- Total duration in months (60 years) -->
    <startmonth>1</startmonth>
    <startyear>2018</startyear>
    <decay>never</decay> <!-- Disable decay during simulation -->
  </control>

  <!-- ======== Archetype declarations ======== -->
  <archetypes>
      <spec><lib>cycamore</lib><name>Enrichment</name></spec>   <!-- Uranium enrichment facility -->
      <spec><lib>cycamore</lib><name>Reactor</name></spec>       <!-- Generic reactor archetype -->
      <spec><lib>cycamore</lib><name>Source</name></spec>        <!-- Material source (e.g., mine) -->
      <spec><lib>cycamore</lib><name>Sink</name></spec>          <!-- Material sink (e.g., repository) -->
      <spec><lib>cycamore</lib><name>FuelFab</name></spec>       <!-- Fuel fabrication plant -->
      <spec><lib>cycamore</lib><name>Separations</name></spec>   <!-- Reprocessing / separation facility -->
	  <!-- NEW CYCAMORE ARGUMENT -->
      <spec><lib>cycamore</lib><name>DeployInst</name></spec>    <!-- Dynamic deployment institution -->
      <spec><lib>agents</lib><name>NullRegion</name></spec>      <!-- Simplified region agent -->
      <spec><lib>agents</lib><name>NullInst</name></spec>        <!-- Simplified institution agent -->
  </archetypes>

  <!-- ======== Commodity definitions ======== -->
  <!-- Define traded materials between facilities -->
  <commodity><name>u_ore</name><solution_priority>1.0</solution_priority></commodity>          <!-- Natural uranium -->
  <commodity><name>fresh_uox</name><solution_priority>1.0</solution_priority></commodity>       <!-- Enriched UOX fuel -->
  <commodity><name>tails</name><solution_priority>1.0</solution_priority></commodity>           <!-- Depleted uranium tails -->
  <commodity><name>spent_uox</name><solution_priority>1.0</solution_priority></commodity>       <!-- Spent UOX fuel -->
  <commodity><name>used_mox_fuel</name><solution_priority>1.0</solution_priority></commodity>   <!-- Spent MOX fuel -->
  <commodity><name>fresh_mox</name><solution_priority>1.0</solution_priority></commodity>       <!-- Fresh MOX fuel -->
  <commodity><name>separated_fissile</name><solution_priority>1.0</solution_priority></commodity> <!-- Recovered fissile (e.g., Pu) -->
  <commodity><name>separated_waste</name><solution_priority>1.0</solution_priority></commodity>   <!-- Reprocessing waste -->

  <!-- ======== Facility definitions ======== -->

  <!-- Uranium source -->
  <facility>
    <name>UraniumMine</name>
    <config>
      <Source>
        <outcommod>u_ore</outcommod>
      </Source>
    </config>
  </facility>

  <!-- Uranium enrichment facility -->
  <facility>
    <name>EnrichmentPlant</name>
    <config>
      <Enrichment>
        <feed_commod>u_ore</feed_commod>
        <feed_recipe>nat_u</feed_recipe>
        <product_commod>fresh_uox</product_commod>
        <tails_commod>tails</tails_commod>
        <max_feed_inventory>1000000</max_feed_inventory>
      </Enrichment>
    </config>
  </facility>

  <!-- 1178 MWe UOX-fueled reactor -->
  <facility>
    <name>1178MWe BRAIDWOOD_1</name>
    <config>
      <Reactor>
        <fuel_incommods><val>fresh_uox</val></fuel_incommods>
        <fuel_inrecipes><val>fresh_uox</val></fuel_inrecipes>
        <fuel_outcommods><val>spent_uox</val></fuel_outcommods>
        <fuel_outrecipes><val>spent_uox</val></fuel_outrecipes>
        <cycle_time>18</cycle_time> <!-- 18-month cycle -->
        <refuel_time>1</refuel_time> <!-- 1-month refueling downtime -->
        <assem_size>33000</assem_size>
        <n_assem_core>3</n_assem_core>
        <n_assem_batch>1</n_assem_batch>
        <power_cap>1178</power_cap> <!-- Electric capacity in MWe -->
      </Reactor>
    </config>
  </facility>

  <!-- 1000 MWe UOX-fueled light water reactor -->
  <facility>
    <name>1000MWe LIGHTWATER_1</name>
    <lifetime>360</lifetime> <!-- 30 years of operation -->
    <config>
      <Reactor>
        <fuel_incommods><val>fresh_uox</val></fuel_incommods>
        <fuel_inrecipes><val>fresh_uox</val></fuel_inrecipes>
        <fuel_outcommods><val>spent_uox</val></fuel_outcommods>
        <fuel_outrecipes><val>spent_uox</val></fuel_outrecipes>
        <cycle_time>12</cycle_time>
        <refuel_time>1</refuel_time>
        <assem_size>33000</assem_size>
        <n_assem_core>3</n_assem_core>
        <n_assem_batch>1</n_assem_batch>
        <power_cap>1000</power_cap>
      </Reactor>
    </config>
  </facility>

  <!-- UOX/MOX reprocessing facility -->
  <facility>
    <name>uox_mox_reprocessing</name>
    <config>
      <Separations>
         <feed_commods>
           <val>used_mox_fuel</val>
           <val>spent_uox</val>
         </feed_commods>
         <feed_commod_prefs>
           <val>1.0</val>
           <val>1.0</val>
         </feed_commod_prefs>
         <feedbuf_size>1000e+3</feedbuf_size> <!-- Input buffer size -->
         <throughput>80e+3</throughput>        <!-- Monthly throughput -->
         <leftover_commod>separated_waste</leftover_commod>
         <streams>
          <item>
            <commod>separated_fissile</commod> <!-- Extracted fissile stream -->
            <info>
              <buf_size>5e+4</buf_size>
              <efficiencies>
                <item>
                  <comp>Pu</comp> <eff>.99</eff> <!-- 99% recovery efficiency -->
                </item>
              </efficiencies>
            </info>
          </item>
        </streams>
      </Separations>
    </config>
  </facility>

  <!-- MOX fuel fabrication plant -->
  <!-- Throughput must be larger than fill_size + fiss_size to produce MOX -->
  <facility>
    <config>
      <FuelFab>
        <fill_commods><val>u_ore</val></fill_commods>
        <fill_recipe>nat_u</fill_recipe>
        <fill_size>94e+3</fill_size>
        <fiss_commod_prefs><val>1</val></fiss_commod_prefs>
        <fiss_commods><val>separated_fissile</val></fiss_commods>
        <fiss_size>6e+3</fiss_size>
        <outcommod>fresh_mox</outcommod>
        <spectrum>thermal</spectrum>
        <throughput>1e+5</throughput>
      </FuelFab>
    </config>
    <name>uox_mox_fuel_fab</name>
  </facility>

  <!-- ALWR (Advanced Light Water Reactor) accepting UOX and MOX fuel -->
  <facility>
    <name>1000MWe ALWR_1</name>
    <lifetime>360</lifetime>
    <config>
      <Reactor>
        <fuel_incommods>
          <val>fresh_uox</val>
          <val>fresh_mox</val>
        </fuel_incommods>
        <fuel_inrecipes>
          <val>fresh_uox</val>
          <val>fresh_mox</val> <!-- Corrected from previous fresh_uox -->
        </fuel_inrecipes>
        <fuel_prefs>
          <val>1.0</val>
          <val>2.0</val>
        </fuel_prefs>
        <fuel_outcommods>
          <val>spent_uox</val>
          <val>used_mox_fuel</val>
        </fuel_outcommods>
        <fuel_outrecipes>
          <val>spent_uox</val>
          <val>used_mox</val>
        </fuel_outrecipes>
        <cycle_time>18</cycle_time>
        <refuel_time>1</refuel_time>
        <assem_size>33000</assem_size>
        <n_assem_core>3</n_assem_core>
        <n_assem_batch>1</n_assem_batch>
        <power_cap>1000</power_cap>
      </Reactor>
    </config>
  </facility>

  <!-- Final waste repository -->
  <facility>
    <name>NuclearRepository</name>
    <config>
      <Sink>
        <in_commods>
          <val>spent_uox</val>
          <val>tails</val>
          <val>separated_waste</val>
        </in_commods>
      </Sink>
    </config>
  </facility>

  <!-- ======== Region and DeployInst configuration ======== -->
  <region>
    <name>USA</name>
    <config><NullRegion/></config>

    <!-- DeployInst dynamically builds all facilities over time -->
    <institution>
      <name>ExampleInstitution</name>
      <config>
        <DeployInst>
          <prototypes>
		    <val>NuclearRepository</val>     <!-- Sink -->
            <val>UraniumMine</val>
            <val>EnrichmentPlant</val>
            <val>uox_mox_fuel_fab</val>
            <val>uox_mox_reprocessing</val>
            <val>1178MWe BRAIDWOOD_1</val>
            <val>1000MWe LIGHTWATER_1</val>
            <val>1000MWe ALWR_1</val>
          </prototypes>
          <build_times>
		    <val>1</val>  <!-- NuclearRepository -->
            <val>1</val>  <!-- UraniumMine -->
            <val>2</val>  <!-- EnrichmentPlant -->
            <val>3</val>  <!-- FuelFab -->
            <val>4</val>  <!-- Reprocessing -->
            <val>5</val>  <!-- BRAIDWOOD -->
            <val>6</val>  <!-- LIGHTWATER -->
            <val>7</val>  <!-- ALWR -->
          </build_times>
          <n_build>
            <val>1</val><val>1</val><val>1</val><val>1</val><val>1</val><val>1</val><val>1</val><val>1</val>
          </n_build>
        </DeployInst>
      </config>
    </institution>
  </region>

  <!-- ======== Fuel recipes ======== -->
  <recipe>
    <name>nat_u</name>
    <basis>mass</basis>
    <nuclide><id>92235</id><comp>0.00711</comp></nuclide>
    <nuclide><id>92238</id><comp>0.99289</comp></nuclide>
  </recipe>

  <recipe>
    <name>fresh_uox</name>
    <basis>mass</basis>
    <nuclide><id>92235</id><comp>0.04</comp></nuclide>
    <nuclide><id>92238</id><comp>0.96</comp></nuclide>
  </recipe>

  <!-- Added MOX fresh fuel recipe -->
  <recipe>
    <name>fresh_mox</name>
    <basis>mass</basis>
    <nuclide><id>92235</id><comp>0.01</comp></nuclide>
    <nuclide><id>92238</id><comp>0.90</comp></nuclide>
    <nuclide><id>94239</id><comp>0.08</comp></nuclide>
    <nuclide><id>94240</id><comp>0.01</comp></nuclide>
  </recipe>

  <!-- Used MOX fuel recipe -->
  <recipe>
    <name>used_mox</name>
    <basis>mass</basis>
    <nuclide><id>92235</id><comp>0.002</comp></nuclide>
    <nuclide><id>92238</id><comp>0.94</comp></nuclide>
    <nuclide><id>94239</id><comp>0.01</comp></nuclide>
    <nuclide><id>94240</id><comp>0.002</comp></nuclide>
    <nuclide><id>55137</id><comp>0.046</comp></nuclide>
  </recipe>

  <!-- Spent UOX fuel recipe -->
  <recipe>
    <name>spent_uox</name>
    <basis>mass</basis>
    <nuclide><id>92235</id><comp>0.011</comp></nuclide>
    <nuclide><id>92238</id><comp>0.94</comp></nuclide>
    <nuclide><id>94239</id><comp>0.009</comp></nuclide>
    <nuclide><id>55137</id><comp>0.04</comp></nuclide>
  </recipe>

</simulation>
